# ---- NoneBot ----
# OneBot v11 正向 WebSocket 需要支持 WS 客户端的驱动
DRIVER=~websockets
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]

# ---- OneBot v11 正向 WebSocket ----
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=

# ---- Rework 渲染 ----
# 留空使用仓库自带的 nonebot_plugin_rework/tosu_plugin
REWORK_PLUGIN_DIR=
REWORK_RENDER_HOST=127.0.0.1
REWORK_RENDER_PORT=24750
# 用系统 Edge 填 msedge；用 Playwright 自带 Chromium 留空
REWORK_BROWSER_CHANNEL=msedge
REWORK_HEADLESS=true
REWORK_DEVICE_SCALE_FACTOR=2
REWORK_PAGE_TIMEOUT_MS=180000
REWORK_SETTLE_MS=1500

# ---- 谱面来源 ----
REWORK_BEATMAP_URL=https://osu.direct/api/osu/{id}
REWORK_BEATMAPSET_URL=https://osu.direct/api/d/{id}
REWORK_USER_AGENT=nonebot-plugin-rework/1.0
REWORK_HTTP_TIMEOUT_SEC=60
REWORK_MAX_BEATMAPS_PER_PACK=40
REWORK_INCLUDE_BACKGROUND=true

# ---- 产物与缓存 ----
REWORK_DATA_DIR=data
# 留空时使用 <REWORK_DATA_DIR>/temp
REWORK_TEMP_DIR=
REWORK_KEEP_FILES=false
REWORK_CACHE_ENABLED=true

# ---- 发送 ----
REWORK_SEND_AS_FORWARD=true
REWORK_FORWARD_NAME="Rework 谱面分析"
REWORK_FORWARD_UIN=10000

# ---- 访问控制 ----
REWORK_ALLOW_GROUP=true
REWORK_ALLOW_PRIVATE=true
REWORK_GROUP_ALLOWLIST=[]
REWORK_USER_DENYLIST=[]
